# ---------------------------------------------------------------- Telegram ---
# Токен бота от @BotFather. НИКОГДА не коммитьте настоящий .env в git.
BOT_TOKEN=123456789:AAAA-your-telegram-bot-token

# ОБЯЗАТЕЛЬНО: Telegram ID владельца (можно несколько через запятую).
# Бот закрытый — без владельца в него не войдёт никто. Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# ---------------------------------------------------------------- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./servereye.db

# ---------------------------------------------------------------- Мониторинг ---
SERVER_CHECK_INTERVAL_MINUTES=60
MAX_CONCURRENT_CHECKS=10
PING_COUNT=4
PING_TIMEOUT=4
HTTP_TIMEOUT=10
TCP_TIMEOUT=6

# ---------------------------------------------------------------- Отчёты ---
HOURLY_REPORT_MINUTE=0
DAILY_REPORT_HOUR=9
DEFAULT_TZ_OFFSET=3

# cloudflare | mirrors

# ---------------------------------------------------------------- ServerEye Agent ---
AGENT_API_ENABLED=true
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8787
# Адрес, который увидит агент на удалённом сервере (домен или внешний IP)
AGENT_PUBLIC_URL=http://127.0.0.1:8787
AGENT_OFFLINE_AFTER_SECONDS=180
AGENT_HEARTBEAT_SECONDS=60

# ---------------------------------------------------------------- Хранение ---
DATA_RETENTION_DAYS=45

# ---------------------------------------------------------------- Прочее ---
LOG_LEVEL=INFO
CHARTS_ENABLED=true

# ---------------------------------------------------------------- Железо ---
# Машину, на которой работает бот, пингуем не саму (это всегда 0 ms), а до
# этих адресов — так виден её интернет. Первая ответившая цель, по порядку.
LOCAL_PING_TARGETS=8.8.8.8,1.1.1.1
# Кнопка «⏻ Выключить» для машины, на которой работает бот (только для ADMIN_IDS)
POWER_CONTROL_ENABLED=false
# Тревога о перегреве CPU повторяется каждые N минут, пока не остынет
TEMP_ALARM_REPEAT_MINUTES=3
# Тревога снимается, когда температура ниже порога на столько градусов
TEMP_ALARM_CLEAR_DELTA=5
# Уровни заряда (%) для предупреждений при работе от батареи
BATTERY_ALERT_LEVELS=20,10,5
